# Auto detect text files and perform LF normalization
* text=auto

# 생성 파일은 워크트리에서도 LF 로 둔다.
#
# 위의 `text=auto` 아래에서 Windows 체크아웃은 CRLF 인데, 이 파일들을 만드는
# 도구(flutter pub get, build_runner, intl_utils, flutter_tweakcn_generator)는
# 항상 LF 로 쓴다. 그래서
# Windows 에서 도구를 한 번만 돌려도 **내용이 한 글자도 안 바뀐 생성물이 통째로
# 수정으로 뜬다.** git diff 는 아무것도 못 보여주는데 status 만 더러운,
# 진단하기 고약한 상태가 된다.
#
# eol=lf 로 못박으면 도구가 쓰는 것과 체크아웃되는 것이 같아져 그 일이 없다.
# CRLF 여야 하는 소비자는 없다 — MSVC 도 CMake 도 Dart 도 LF 를 그대로 읽는다.
#
# 손으로 쓰는 소스는 여기 넣지 않는다. dart format 은 기존 줄바꿈을 보존하므로
# 같은 문제를 일으키지 않고, 굳이 강제할 이유도 없다.

# Flutter 가 플랫폼 폴더에 만드는 플러그인 등록 파일
generated_plugin_registrant.*   text eol=lf
generated_plugins.cmake         text eol=lf
GeneratedPluginRegistrant.swift text eol=lf

# build_runner (riverpod) + flutter_tweakcn_generator CLI (tweakcn 테마).
# 테마는 build_runner 가 만들지 않는다 — CLI 가 만든다.
*.g.dart                        text eol=lf

# intl_utils
**/localization/generated/**    text eol=lf
